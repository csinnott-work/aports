From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cris Sinnott <csinnott@qnx.com>
Date: Sun, 15 Nov 2026 18:33:59 +0000
Subject: [PATCH] Accept EOF after the last key in the NTS cookie key file

---
 ntpd/nts_cookie.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/ntpd/nts_cookie.c b/ntpd/nts_cookie.c
index 5e4fded..896432f 100644
--- a/ntpd/nts_cookie.c
+++ b/ntpd/nts_cookie.c
@@ -206,7 +206,9 @@ bool nts_read_cookie_keys(void) {
 		}
 		key->K[j] = temp;
 	  }
-	  if (0 != fscanf(in, "\n")) {
+	  /* EOF after the last key is not an error; some libcs return it here */
+	  int nl = fscanf(in, "\n");
+	  if (0 != nl && EOF != nl) {
 		goto bail;
 	  }
 	  nts_nKeys = i+1;
-- 
